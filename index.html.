<script data-page-node-id="i3R717rCaElM8vyuQIq2wc" data-pnid-children="5YvyOpnLE8fjj822NFIeRo">
/* ---------- PWA 安装与离线缓存 ---------- */
(function(){
  // 注册 Service Worker（file:// 打开时自动跳过，不影响本地使用）
  if("serviceWorker" in navigator && (location.protocol==="https:"||location.hostname==="localhost"||location.hostname==="127.0.0.1")){
    navigator.serviceWorker.register("sw.js").catch(()=>{});
  }
  const bar=document.getElementById("pwaBar");
  const close=document.getElementById("pwaClose");
  const btn=document.getElementById("pwaInstall");
  const how=document.getElementById("pwaHow");
  let deferred=null;
  const standalone=window.matchMedia("(display-mode: standalone)").matches||window.navigator.standalone;
  if(close)close.onclick=()=>{bar.style.display="none";try{localStorage.setItem("pwa_bar_hide",String(Date.now()))}catch(e){}};
  // 已被用户关掉过 7 天内不再提示
  let hidden=false;try{const t=+localStorage.getItem("pwa_bar_hide");hidden=t&&(Date.now()-t<7*864e5)}catch(e){}
  window.addEventListener("beforeinstallprompt",e=>{
    e.preventDefault();deferred=e;
    if(standalone||hidden)return;
    btn.style.display="";how.textContent="一键添加到主屏幕，像 App 一样打开";
    bar.style.display="flex";
  });
  if(btn)btn.onclick=async()=>{
    if(deferred){deferred.prompt();const r=await deferred.userChoice;deferred=null;if(r.outcome==="accepted")bar.style.display="none";return}
    alert("当前浏览器不支持一键添加，请手动添加：\n\n· iPhone/iPad：Safari 底部「分享」→「添加到主屏幕」\n· 安卓微信：右上角「⋯」→「在浏览器打开」→ 再添加到主屏幕");
  };
  window.addEventListener("appinstalled",()=>{bar.style.display="none";toast&&toast("已添加到桌面 🎉")});
  // iOS/微信等不支持自动安装的环境：手动给出提示
  if(!standalone&&!hidden){
    const ua=navigator.userAgent;
    const isIOS=/iPhone|iPad|iPod/i.test(ua);
    const isWechat=/MicroMessenger/i.test(ua);
    if(isIOS||isWechat){
      setTimeout(()=>{
        if(deferred||bar.style.display==="flex")return;
        how.innerHTML=isWechat
          ? "点右上角「⋯」→<b>「在浏览器打开」</b>→ 再点「添加到主屏幕」"
          : "点底部分享 <b>分享按钮</b> →「<b>添加到主屏幕</b>」";
        btn.style.display="none";
        bar.style.display="flex";
      },2500);
    }
  }
})();
</script>
