/* 保存（单节 / 批量共用） */
function saveCourse(){
  const stuId=$("cStu").value;if(!stuId)return alert("请先在学生管理中添加学生");
  const days=pickedDays();
  if(!days.length){alert("请至少选择一个星期");return}
  const mode=$("cTimeMode").value;
  const subjList=pickedSubjects();
  if(!subjList.length){alert(courseMode==="batch"?"请至少选择一个科目":"请选择科目");return}
  const slots=allSlots();
  if(!slots.length){alert("请填写开始和结束时间，或切换为「不固定时间」");return}

  // 编辑：只处理单条
  if(editing.course){
    const t=db.courses.find(c=>c.id===editing.course);if(!t)return;
    const sl=slots[0];
    const d={stuId,subject:subjList[0],days,day:days[0],timeMode:mode,note:$("cNote").value.trim(),teacher:$("cTeacher").value.trim()};
    Object.assign(d,courseWeekDates(days));
    if(mode==="free"){d.start="";d.end="";d.freeSlot=$("cFreeSlot").value;d.freeNote=$("cFreeNote").value.trim();}
    else{d.start=sl.start;d.end=sl.end;d.freeSlot="";d.freeNote="";}
    Object.assign(t,d);save();closeModal("courseMask");renderAll();
    ttFilterStu=stuId;renderAll();
    toast("课程已更新");return;
  }

  // 冲突预检（同一学生）
  const clashes=[];
  const plan=[];
  days.forEach(dy=>{
    slots.forEach(sl=>{
      subjList.forEach(sb=>{
        plan.push({dy,sl,sb});
      });
    });
  });
  plan.forEach(p=>{
    if(p.sl.free)return;
    const wk=courseWeekDates([p.dy]);
    const exist=db.courses.find(c=>!isFree(c)&&c.stuId===stuId&&c.day===p.dy&&
      (c.onlyDates&&c.onlyDates.length?c.onlyDates.includes(wk.onlyDates[0]):true)&&
      p.sl.start<c.end&&c.start<p.sl.end);
    if(exist)clashes.push(`${DAYNAMES[p.dy]} ${p.sl.start}-${p.sl.end} 已有「${exist.subject}」`);
  });
  if(clashes.length){
    if(!confirm(`检测到 ${clashes.length} 处时间冲突：\n\n${clashes.slice(0,8).join("\n")}${clashes.length>8?"\n…":""}\n\n冲突的课程将被跳过，其余照常保存。继续吗？`))return;
  }
  let added=0,skipped=0;
  const newIds=[];
  const batch=[];   // 先攒齐再统一写入，避免自己的新课被判为冲突
  plan.forEach(p=>{
    if(!p.sl.free){
      // 与「已存在的其他学生课程」不冲突；只与「该学生本时段已有课」冲突
      const exist=db.courses.find(c=>!isFree(c)&&c.stuId===stuId&&c.day===p.dy&&p.sl.start<c.end&&c.start<p.sl.end);
      if(exist){skipped++;return}
    }
    const d={stuId,subject:p.sb,days:[p.dy],day:p.dy,timeMode:mode,note:$("cNote").value.trim(),teacher:$("cTeacher").value.trim()};
    Object.assign(d,courseWeekDates([p.dy]));
    if(p.sl.free){d.start="";d.end="";d.freeSlot=$("cFreeSlot").value;d.freeNote=$("cFreeNote").value.trim();}
    else{d.start=p.sl.start;d.end=p.sl.end;d.freeSlot="";d.freeNote="";}
    const id=uid();newIds.push(id);batch.push({id,...d});
  });
  batch.forEach(c=>{db.courses.push(c);added++});
  save();closeModal("courseMask");
  ttFilterStu=stuId;
  renderAll();
  if(newIds.length)highlightCourse(newIds[0]);
  const stuName=(stuById(stuId)||{}).name||"";
  if(courseMode==="batch")toast(`已批量添加 ${added} 节课程${skipped?`（${skipped} 节因冲突跳过）`:""}`);
  else toast(`已添加：${stuName} · ${subjList[0]} · ${days.map(x=>DAYNAMES[x]).join("、")}${mode==="free"?"（时间待定）":" "+slots[0].start+"-"+slots[0].end}`);
}
