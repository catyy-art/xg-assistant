function rate(g){return Math.round(g.score/g.full*100)}
function renderAnalysis(){const stuId=$("aStu").value;if(!stuId){$("chartTrend")&&($("chartTrend").innerHTML='<div class="empty">暂无学生</div>');return}
  const gs=db.grades.filter(g=>g.stuId===stuId).sort((a,b)=>a.date<b.date?-1:1);
  if(typeof echarts==="undefined"){$("aiSummary").innerHTML="图表库未加载（无网络），趋势数据仍可在成绩页查看。";return}
  // 趋势
  const tc=echarts.init($("chartTrend"));tc.setOption({tooltip:{trigger:"axis"},grid:{left:40,right:20,top:30,bottom:30},
    xAxis:{type:"category",data:gs.map(g=>g.date+"\n"+g.exam)},
    yAxis:{type:"value",max:100,name:"得分率%"},
    series:[{type:"line",data:gs.map(rate),smooth:true,lineStyle:{color:"#4f6ef7",width:3},itemStyle:{color:"#4f6ef7"},areaStyle:{color:"rgba(79,110,247,.12)"},label:{show:true}}]});
  // 各科
  const subs={};gs.forEach(g=>{(subs[g.subject]=subs[g.subject]||[]).push(rate(g))});
  const sc=echarts.init($("chartSubject"));
  sc.setOption({tooltip:{},grid:{left:40,right:20,top:30,bottom:30},
    xAxis:{type:"category",data:Object.keys(subs)},yAxis:{type:"value",max:100},
    series:[{type:"bar",data:Object.values(subs).map(a=>Math.round(a.reduce((x,y)=>x+y,0)/a.length)),itemStyle:{color:"#4f6ef7",borderRadius:[6,6,0,0]},label:{show:true}}]});
  // AI 小结
  let html="";
  if(gs.length<2){html="📌 该学生成绩记录不足 2 条，录入更多成绩后可生成趋势分析。"}
  else{
    const first=gs[0],last=gs[gs.length-1];const diff=rate(last)-rate(first);
    const recent=gs.slice(-3);const avgR=Math.round(recent.reduce((a,g)=>a+rate(g),0)/recent.length);
    const best=[...gs].sort((a,b)=>rate(b)-rate(a))[0];const worst=[...gs].sort((a,b)=>rate(a)-rate(b))[0];
    html+=`<p>📈 最近趋势：从 <b>${rate(first)}%</b>（${first.date}）到 <b>${rate(last)}%</b>（${last.date}），${diff>=0?`<span style="color:var(--success)">提升 ${diff} 个百分点</span>`:`<span style="color:var(--danger)">下降 ${-diff} 个百分点</span>`}。</p>`;
    html+=`<p>🎯 近三次平均得分率 <b>${avgR}%</b>；最强表现：${esc(best.subject)} ${best.exam}（${rate(best)}%）；需加强：${esc(worst.subject)}（${rate(worst)}%）。</p>`;
    html+=diff>=5?`<p>💡 建议：进步明显，可与家长沟通阶段性成果，并适当提高练习难度。</p>`:
          diff<=-5?`<p>💡 建议：成绩有所下滑，建议尽快约家长面谈，排查近期学习状态与作业完成情况。</p>`:
          `<p>💡 建议：成绩整体平稳，可针对薄弱科目制定专项练习计划。</p>`;
  }
  $("aiSummary").innerHTML=html}

