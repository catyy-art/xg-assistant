/* 某日期是否落在课程的生效范围内（课程只属于创建时的那一周） */
function courseOnDate(c,dateObj){
  const dk=dateKey(dateObj);
  if(Array.isArray(c.onlyDates)&&c.onlyDates.length)return c.onlyDates.includes(dk);
  if(c.weekStart){   // 老数据兜底：按创建那一周判断
    const [y,m,dd]=c.weekStart.split("-").map(Number);
    const mon=new Date(y,m-1,dd);
    const end=new Date(mon);end.setDate(mon.getDate()+6);
    if(dk<dateKey(mon)||dk>dateKey(end))return false;
  }
  return (c.days||[c.day]).includes(dateObj.getDay());
}
function renderWhoWhen(){
  const dateStr=$("wsDate").value||today();
