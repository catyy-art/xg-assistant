:root{
  --primary:#4f6ef7; --primary-light:#eef1fe; --danger:#e5484d;
  --bg:#f5f6fa; --card:#fff; --text:#2b2f36; --muted:#8a919c;
  --border:#e6e8ef; --success:#2f9e6e; --warn:#e8a33d;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:"PingFang SC","Microsoft YaHei",system-ui,sans-serif;background:var(--bg);color:var(--text);font-size:14px}
.app{display:flex;min-height:100vh}
/* 侧边栏 */
.sidebar{width:210px;background:linear-gradient(180deg,#f7f9ff 0%,#eef1fb 100%);border-right:1px solid var(--border);padding:18px 12px;flex-shrink:0;display:flex;flex-direction:column}
.logo{font-size:18px;font-weight:800;padding:6px 12px 22px;background:linear-gradient(90deg,#4f6ef7,#9b59f6);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;letter-spacing:1px}
.nav-item{position:relative;display:flex;align-items:center;gap:10px;padding:11px 14px;border-radius:12px;cursor:pointer;color:#5b6270;margin-bottom:5px;font-weight:600;transition:all .18s}
.nav-item .icon{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:9px;background:#fff;box-shadow:0 1px 3px rgba(79,110,247,.12);font-size:16px;transition:all .18s}
.nav-item:hover{background:#fff;color:var(--primary);transform:translateX(3px);box-shadow:0 2px 8px rgba(79,110,247,.10)}
.nav-item.active{background:linear-gradient(90deg,var(--primary),#7b8ffb);color:#fff;box-shadow:0 4px 12px rgba(79,110,247,.35)}
.nav-item.active .icon{background:rgba(255,255,255,.22);box-shadow:none}
.nav-item.active::before{content:"";position:absolute;left:-12px;top:20%;height:60%;width:4px;border-radius:0 4px 4px 0;background:var(--primary)}
.side-foot{margin-top:auto;text-align:center;color:#b9bfcb;font-size:11px;padding-top:20px}
.main{flex:1;padding:24px;max-width:1200px}
.page{display:none}
.page.active{display:block}
h2.page-title{font-size:20px;margin-bottom:18px}
/* 卡片与表单 */
.card{background:var(--card);border-radius:14px;padding:20px;border:1px solid var(--border);margin-bottom:18px}
.row{display:flex;gap:16px;flex-wrap:wrap}
.grid4{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
.stat{background:#fff;border:1px solid var(--border);border-radius:14px;padding:16px 18px}
.stat .num{font-size:26px;font-weight:700;color:var(--primary)}
.stat .label{color:var(--muted);font-size:12px;margin-top:4px}
label{display:block;font-size:12px;color:var(--muted);margin:10px 0 4px}
input,select,textarea{width:100%;padding:9px 10px;border:1px solid var(--border);border-radius:8px;font-size:14px;background:#fff;font-family:inherit}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--primary)}
.btn{display:inline-block;background:var(--primary);color:#fff;border:none;border-radius:8px;padding:9px 18px;cursor:pointer;font-size:14px;margin-top:12px}
.btn:hover{opacity:.9}
.btn.ghost{background:#fff;color:var(--text);border:1px solid var(--border)}
.btn.danger{background:var(--danger)}
.btn.sm{padding:4px 10px;font-size:12px;margin:0}
/* 表格 */
table{width:100%;border-collapse:collapse}
th,td{padding:10px 8px;text-align:left;border-bottom:1px solid var(--border);font-size:13px;vertical-align:middle}
th{color:var(--muted);font-weight:500;font-size:12px}
/* 课程表 */
.tt-grid{display:grid;grid-template-columns:60px repeat(7,1fr);gap:6px}
.tt-cell{background:#fff;border:1px solid var(--border);border-radius:8px;min-height:56px;padding:6px;font-size:11px}
.tt-break{background:repeating-linear-gradient(45deg,#fafbfd,#fafbfd 8px,#f1f3f8 8px,#f1f3f8 16px)!important;color:#b9bfcb;display:flex;align-items:center;justify-content:center;font-size:12px}
.tt-cell.period-name{display:flex;flex-direction:column;justify-content:center}
.tt-cell.period-name b{font-size:12px;color:var(--text)}
.tt-cell.period-name span{color:var(--muted);font-size:10px}
.tt-head{background:transparent;border:none;text-align:center;font-weight:600;color:var(--muted);min-height:28px;padding:4px}
.tt-time{display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:12px}
.course-chip{background:var(--primary-light);border-left:3px solid var(--primary);border-radius:6px;padding:4px 6px;line-height:1.5;cursor:pointer;transition:transform .12s,box-shadow .12s}
.course-chip:hover{transform:translateY(-2px);box-shadow:0 4px 10px rgba(79,110,247,.25)}
.course-chip b{display:block;font-size:12px;color:var(--primary)}
.stu-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:4px;vertical-align:middle}
.legend{display:flex;flex-wrap:wrap;gap:8px 14px;margin-top:14px;font-size:12px;color:var(--muted)}
.days-picker{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px}
.days-picker label{display:flex;align-items:center;gap:4px;margin:0;padding:6px 10px;border:1px solid var(--border);border-radius:8px;background:#fff;font-size:13px;color:var(--text);cursor:pointer;user-select:none}
.days-picker input{width:auto;margin:0}
.days-picker label:has(input:checked){background:var(--primary-light);border-color:var(--primary);color:var(--primary);font-weight:600}
.pend-chip{border:1px dashed var(--border)!important;background:#fafbfd!important}
.week-nav{display:flex;align-items:center;gap:12px;justify-content:center;margin-bottom:16px;flex-wrap:wrap}
.wk-btn{border:1px solid #eef0f6;background:#f7f8fc;border-radius:20px;padding:6px 15px;font-size:13px;cursor:pointer;color:#5b6270;font-family:inherit}
.wk-btn:hover{background:#eef1fe;color:var(--primary);border-color:#dfe4fb}
.wk-badge{background:#e6f6ef;color:var(--success);border-radius:10px;padding:3px 10px;font-size:12px;font-weight:600}
.float-add{position:fixed;right:34px;bottom:34px;width:56px;height:56px;border-radius:50%;border:none;background:linear-gradient(135deg,#7b8ffb,#4f6ef7);color:#fff;font-size:26px;box-shadow:0 8px 20px rgba(79,110,247,.4);cursor:pointer;z-index:40}
.float-add:hover{transform:scale(1.06)}
.period-list{display:flex;flex-wrap:wrap;gap:8px}
.period-pill{display:flex;align-items:center;gap:7px;border:1px solid var(--border);background:#fafbfe;border-radius:10px;padding:7px 12px;font-size:12px}
.period-pill b{font-size:12.5px}
.period-pill .t{color:var(--muted);font-size:11px}
.period-pill.break{background:repeating-linear-gradient(45deg,#fafbfd,#fafbfd 8px,#f1f3f8 8px,#f1f3f8 16px);color:#b0b7c3}
.period-pill.used{border-color:#bfe3d0;background:#eefaf3}
.tt-free{background:#fcfdff;cursor:pointer;position:relative;padding:2px}
.tt-free:hover{background:#eef3ff}
/* 自习标签 */
.ss-chip{display:block;width:100%;box-sizing:border-box;text-align:center;font-size:11px;color:#a3aab8;letter-spacing:1px;padding:4px 0;border-radius:6px;background:repeating-linear-gradient(135deg,#f7f8fb,#f7f8fb 6px,#f0f2f7 6px,#f0f2f7 12px);cursor:pointer;user-select:none;transition:background .12s,color .12s}
.ss-chip:hover{background:#dde6ff!important;color:#4f6ef7!important}
.tt-free:hover .ss-chip{background:#e8eeff;color:#7b8ffb}
/* 周视图卡片：仿手机课表（浅底、圆角、细边框） */
.wk-chip{border:1px solid;border-radius:9px;padding:6px 8px;margin-bottom:5px;font-size:11px;line-height:1.55;cursor:pointer;position:relative;background:#fff;transition:transform .12s,box-shadow .12s}
.wk-chip:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(79,110,247,.14)}
.wk-chip b{display:block;font-size:12px;font-weight:600;letter-spacing:.2px}
.wk-chip.done{opacity:.58}
.wk-chip.done b{text-decoration:line-through}
.wk-tick{position:absolute;right:5px;top:5px;width:15px;height:15px;accent-color:#2f9e6e;cursor:pointer}
.tt-tag{display:inline-block;border-radius:5px;padding:1px 7px;font-size:10px;margin-top:3px}
.quick-slots{display:flex;gap:6px;flex-wrap:wrap}
.quick-slots button{border:1px solid var(--border);background:#fff;border-radius:14px;padding:3px 10px;font-size:12px;cursor:pointer;color:var(--muted)}
.quick-slots button:hover,.quick-slots button.on{border-color:var(--primary);color:var(--primary);background:var(--primary-light)}
/* 时间点查课「已上课」勾选 */
.ws-done{display:inline-flex;align-items:center;gap:5px;flex-shrink:0;background:#f1f3f9;border:1px solid #dde2ee;border-radius:20px;padding:6px 12px;font-size:12px;color:#7a8291;cursor:pointer;user-select:none;transition:all .15s}
.ws-done input{width:auto;margin:0;accent-color:#2f9e6e;cursor:pointer}
.ws-done.on{background:#e6f6ef;border-color:#b9e3cc;color:#2f9e6e;font-weight:600}
/* 备忘：之前未完成清单 */
.memo-pending{margin:0 0 12px}
.mp-head{display:flex;align-items:center;gap:8px;background:#fff8ec;border:1px solid #f5dfb8;border-radius:10px;padding:9px 12px;cursor:pointer;font-size:13px;color:#b2761c}
.mp-head:hover{background:#fdf2e2}
.mp-num{background:#e8a33d;color:#fff;border-radius:20px;padding:0 7px;font-size:11px;margin-left:2px}
.mp-arrow{margin-left:auto;color:#c9a264;font-size:12px}
.mp-body{background:#fffdf8;border:1px solid #f5e6cd;border-top:none;border-radius:0 0 10px 10px;padding:6px 12px 10px;max-height:230px;overflow:auto}
.mp-day{margin-top:8px}
.mp-date{font-size:11px;color:var(--muted);margin-bottom:4px;cursor:pointer}
.mp-date:hover{color:var(--primary);text-decoration:underline}
.mp-item{display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px dashed #f2ece0}
.mp-item:last-child{border-bottom:none}
.mp-txt{flex:1;font-size:13px;color:var(--text);cursor:pointer;line-height:1.5}
.mp-txt:hover{color:var(--primary)}
.mp-go{color:#cdd3de;font-size:12px;cursor:pointer;flex-shrink:0}
.mp-go:hover{color:var(--primary)}
/* 报名档案照片 */
.arch-thumbs{display:flex;gap:8px;flex-wrap:wrap}
.arch-thumb{position:relative;width:74px;height:74px;border-radius:10px;overflow:hidden;border:1px solid var(--border);cursor:pointer}
.arch-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.arch-thumb .arch-del{position:absolute;top:2px;right:2px;width:18px;height:18px;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;font-size:11px;display:flex;align-items:center;justify-content:center;cursor:pointer}
.arch-thumb .arch-del:hover{background:var(--danger)}
.arch-empty{font-size:11px;color:var(--muted)}
#archViewer{position:fixed;inset:0;z-index:2000;background:rgba(15,20,35,.82);display:none;align-items:center;justify-content:center;cursor:zoom-out}
#archViewer img{max-width:92vw;max-height:90vh;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,.4)}
.who-row{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:10px;background:#fafbfe;border:1px solid var(--border);margin-bottom:8px}
.who-avatar{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;font-weight:700;flex-shrink:0}
.seg{display:flex;background:#f2f4f9;border-radius:10px;padding:3px}
.seg button{border:none;background:transparent;padding:6px 14px;border-radius:8px;font-size:13px;color:var(--muted);cursor:pointer;font-family:inherit}
.seg button.on{background:#fff;color:var(--primary);font-weight:600;box-shadow:0 1px 4px rgba(0,0,0,.08)}
.mini-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
.mini-col-head{text-align:center;font-weight:600;color:var(--muted);font-size:12px;padding:6px 0}
.mini-col{background:#fafbfe;border:1px solid var(--border);border-radius:10px;padding:6px;min-height:120px}
.mini-col.today{background:var(--primary-light);border-color:#c9d3f9}
.mini-course{border-radius:7px;padding:5px 6px;margin-bottom:6px;font-size:11px;line-height:1.5;cursor:pointer;border-left:3px solid}
.mini-course b{display:block;font-size:12px}
.mini-course:hover{filter:brightness(.97);transform:translateY(-1px)}
.mg-item{display:flex;align-items:center;gap:8px;padding:9px 12px;border-radius:8px;font-size:13px;cursor:pointer}
.mg-item:hover{background:#f0f3fe}
.counter-bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.counter-card{display:flex;align-items:center;gap:8px;border:1px solid var(--border);background:#fafbfe;border-radius:10px;padding:7px 12px;font-size:13px}
.counter-card .subj{font-weight:700}
.counter-card .cnt{color:var(--muted);font-size:11px}
.done-tick{position:absolute;right:5px;top:5px;width:16px;height:16px;cursor:pointer;accent-color:#2f9e6e}
.course-chip{position:relative}
.course-chip.done{opacity:.72}
.course-chip.done .subj-name{text-decoration:line-through}
.tag{display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px}
.tag.ok{background:#e6f6ef;color:var(--success)}
.tag.warn{background:#fdf3e3;color:var(--warn)}
.tag.risk{background:#fdeaea;color:var(--danger)}
.empty{text-align:center;color:var(--muted);padding:30px 0}
.chat-item{border-left:3px solid var(--primary);background:var(--primary-light);border-radius:0 8px 8px 0;padding:8px 12px;margin:6px 0;font-size:13px}
.chat-item .meta{color:var(--muted);font-size:11px;margin-bottom:2px}
.chat-item.contacted{border-left-color:#2f9e6e}
.contact-label{display:inline-flex;align-items:center;gap:5px;font-size:12px;color:#7a8291;cursor:pointer;user-select:none;background:#fff;border:1px solid #dde2ee;border-radius:20px;padding:3px 10px;flex-shrink:0}
.contact-label input{width:auto;margin:0;accent-color:#2f9e6e;cursor:pointer}
.chat-item.contacted .contact-label{background:#e6f6ef;border-color:#b9e3cc;color:#2f9e6e;font-weight:600}
/* 点格排课条 */
.quickbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;background:#fff;border:1px solid #dde4f6;border-left:4px solid var(--primary);border-radius:12px;padding:11px 14px;margin-bottom:14px;box-shadow:0 2px 10px rgba(79,110,247,.07)}
.qb-left{display:flex;align-items:center;gap:8px;flex-shrink:0}
.qb-label{font-size:12px;font-weight:700;color:var(--primary)}
.qb-stu{font-size:12px;color:var(--muted);background:#f2f4fa;border-radius:20px;padding:3px 11px}
.qb-stu.on{color:var(--primary);background:var(--primary-light);font-weight:600}
.qb-subj{display:flex;gap:6px;flex-wrap:wrap;flex:1;min-width:200px}
.qb-chip{border:1px solid var(--border);background:#fff;border-radius:8px;padding:5px 12px;font-size:12px;cursor:pointer;color:#5b6270;font-family:inherit;transition:all .13s;font-weight:600}
.qb-chip:hover{border-color:#b9c6f2;transform:translateY(-1px)}
.qb-chip.on{font-weight:700;box-shadow:0 3px 9px rgba(79,110,247,.25)}
.qb-right{display:flex;align-items:center;gap:10px;flex-shrink:0}
.qb-hint{font-size:12px;color:var(--muted)}
/* 选中科目后空格可点提示 */
body.qb-active .tt-free{background:#f4f8ff;border-style:dashed;border-color:#b9ccff}
body.qb-active .tt-free:hover{background:#e3ecff;border-color:var(--primary);box-shadow:0 0 0 2px rgba(79,110,247,.18)}
body.qb-active .tt-free .ss-chip{color:#8fa4e8}
/* 点格子弹出的科目菜单 */
.tt-free,.tt-has{cursor:pointer;position:relative;transition:background .12s,border-color .12s}
.cell-add{position:absolute;bottom:1px;right:4px;font-size:12px;font-weight:700;color:#b9c6ea;opacity:0;transition:opacity .12s;pointer-events:none;line-height:1}
.tt-free:hover .cell-add,.tt-has:hover .cell-add{opacity:1}
body.qb-active .tt-free .cell-add,body.qb-active .tt-has .cell-add{opacity:.7;color:#93a8e8}
body.qb-active .tt-has:hover{background:#f3f7ff;box-shadow:inset 0 0 0 1px #c9d6fa}
.tt-free:hover{background:#f7f9ff;border-color:#c3d0fb}
.tt-free.adding{background:#eaf0ff !important;border-color:var(--primary) !important;box-shadow:inset 0 0 0 2px rgba(79,110,247,.35)}
#subjPop{position:absolute;z-index:900;background:#fff;border:1px solid #e2e8f8;border-radius:14px;box-shadow:0 14px 40px rgba(35,48,90,.18);padding:10px;display:none;width:322px;box-sizing:border-box}
#subjPop.show{display:block;animation:popIn .13s ease-out}
@keyframes popIn{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
.sp-head{display:flex;align-items:center;justify-content:space-between;font-size:12px;font-weight:700;color:var(--text);padding:2px 4px 8px;border-bottom:1px solid #f0f3fa;margin-bottom:8px;gap:8px}
.sp-head .sp-x{cursor:pointer;color:#b9c0cc;font-size:15px;line-height:1;padding:0 3px;flex-shrink:0}
.sp-head .sp-x:hover{color:var(--danger)}
.sp-head .sp-sub{font-weight:500;color:var(--muted);font-size:11px;margin-left:auto;white-space:nowrap}
.sp-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.sp-item{border:1px solid var(--border);background:#fff;border-radius:9px;padding:8px 2px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;color:#5b6270;transition:all .12s;white-space:nowrap}
.sp-item:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(35,48,90,.12)}
.sp-foot{display:flex;justify-content:space-between;align-items:center;margin-top:8px;padding-top:8px;border-top:1px solid #f0f3fa;font-size:11px;color:var(--muted)}
.sp-foot a{color:var(--primary);cursor:pointer;font-weight:600}
.sp-foot a:hover{text-decoration:underline}
@media(max-width:820px){
  #subjPop{width:auto;min-width:280px;padding:9px;border-radius:12px}
  .sp-item{padding:9px 2px;font-size:12px}
  .quickbar{gap:8px;padding:10px}
  .quickbar .qb-left{width:100%}
  .qb-subj{overflow-x:auto;flex-wrap:nowrap;padding-bottom:3px;-webkit-overflow-scrolling:touch;width:100%}
  .qb-chip{flex-shrink:0}
  .qb-right{width:100%}
  .qb-hint{flex:1}
}
/* 批量排课 */
.cmode-switch{display:flex;background:#f1f3f9;border-radius:9px;padding:3px;gap:2px;margin-left:auto}
