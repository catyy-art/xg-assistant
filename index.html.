let archPhotos=[];let curArchStu=null;
function compressImg(file){
  return new Promise((resolve,reject)=>{
    const img=new Image();const url=URL.createObjectURL(file);
    img.onload=()=>{
      const MAX=800;
      let w=img.width,h=img.height;
      if(Math.max(w,h)>MAX){const k=MAX/Math.max(w,h);w=Math.round(w*k);h=Math.round(h*k)}
      const cv=document.createElement("canvas");cv.width=w;cv.height=h;
      cv.getContext("2d").drawImage(img,0,0,w,h);
      URL.revokeObjectURL(url);
      resolve(cv.toDataURL("image/jpeg",0.62));
    };
    img.onerror=()=>{URL.revokeObjectURL(url);reject(new Error("图片读取失败"))};
    img.src=url;
  });
}
function renderArchThumbs(){
  const box=$("sArchThumbs");if(!box)return;
  box.innerHTML=archPhotos.length?archPhotos.map((d,i)=>`
    <div class="arch-thumb"><img src="${d}" onclick="viewArchPhoto('${i}')" title="点击放大">
      <span class="arch-del" onclick="archDel(${i})" title="删除照片">✕</span></div>`).join("")
    :`<span class="arch-empty">还没有照片</span>`;
}
async function archAddFiles(inp){
  const files=[...inp.files];if(!files.length)return;
  inp.value="";
  for(const f of files){
    if(!f.type.startsWith("image/"))continue;
    if(f.size>15*1024*1024){alert("「"+f.name+"」超过 15MB，已跳过");continue}
    try{archPhotos.push(await compressImg(f))}
    catch(e){alert(e.message)}
  }
  renderArchThumbs();
}
function archDel(i){archPhotos.splice(i,1);renderArchThumbs()}
function viewArchPhoto(i){
  const d=archPhotos[Number(i)]||(curArchStu&&((stuById(curArchStu)||{}).photos||[])[Number(i)]);
  if(!d)return;
  const v=$("archViewer")||document.body;
  if(!$("archViewer")){
    const el=document.createElement("div");el.id="archViewer";
    el.innerHTML='<img>';
    el.onclick=()=>el.style.display="none";
    document.body.appendChild(el);
  }
  $("archViewer").querySelector("img").src=d;
  $("archViewer").style.display="flex";
}
