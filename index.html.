/* 当前排课周（偏移 ttWeekOffset 周）的周一日期 */
function weekMonday(offset){
  const now=new Date();now.setHours(0,0,0,0);
  const day=(now.getDay()+6)%7;
  return new Date(now.getFullYear(),now.getMonth(),now.getDate()-day+(offset||0)*7);
}
/* 由星期数组生成本周的对应日期 */
function courseWeekDates(days){
  const mon=weekMonday(ttWeekOffset);
  const onlyDates=days.map(wd=>{
    const d=new Date(mon);
    d.setDate(mon.getDate()+((wd+6)%7));
    return dateKey(d);
  });
  return {onlyDates,weekStart:dateKey(mon)};
}
