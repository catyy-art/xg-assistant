  const out=[];const today=new Date();today.setHours(0,0,0,0);
  const day=(today.getDay()+6)%7;
  const mon=new Date(today.getFullYear(),today.getMonth(),today.getDate()-day);
  const days=c.days||[c.day];
  for(let w=-2;w<12;w++){
