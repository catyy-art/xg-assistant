/* 统计：按「具体某天的一节课」计数 */
function occStats(list){
  let total=0,done=0,selfN=0,selfDone=0;const bySubj={};
  list.forEach(c=>{
    const n=isFree(c)?1:courseDates(c).length||(c.days||[c.day]).length;   // 待定课按1节计
    const doneN=isFree(c)?(c.done?1:0):(c.doneDates||[]).filter(d=>courseDates(c).includes(d)).length
      || (c.done&&!(c.doneDates||[]).length?n:0);
    if(c.subject==="自习"){selfN+=n;return}   // 自习单列，不参与「已上完/未上」统计
    total+=n;done+=Math.min(doneN,n);
    const k=c.subject||"未分类";bySubj[k]=bySubj[k]||{total:0,done:0};bySubj[k].total+=n;bySubj[k].done+=Math.min(doneN,n);
  });
  return {total,done,bySubj,selfN,selfDone};
}
