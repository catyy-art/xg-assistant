/* ---------- 月度上课数据 ---------- */
function mThisMonth(){const d=new Date();$("mMonth").value=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}`;renderMonthly()}
function mShift(n){
  const v=$("mMonth").value||`${new Date().getFullYear()}-${String(new Date().getMonth()+1).padStart(2,"0")}`;
  const [y,m]=v.split("-").map(Number);const d=new Date(y,m-1+n,1);
  $("mMonth").value=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}`;renderMonthly();
}
/* 某月所有课的「某天的实例」 */
function monthInstances(ym){
  const [y,m]=ym.split("-").map(Number);
  const days=new Date(y,m,0).getDate();
  const out=[];
  for(let i=1;i<=days;i++){
    const ds=`${ym}-${String(i).padStart(2,"0")}`;
    const dobj=new Date(ds+"T00:00:00");
    db.courses.forEach(c=>{
      if(isFree(c))return;
      if(!courseOnDate(c,dobj))return;
      out.push({date:ds,course:c,stuId:c.stuId,subject:c.subject||"未分类",
        hours:durH(c.start,c.end),done:isDoneOn(c,ds)});
    });
  }
  return out;
}
function renderMonthly(){
  const mm=$("mMonth");if(!mm||!mm.value){if(mm)mm.value=`${new Date().getFullYear()}-${String(new Date().getMonth()+1).padStart(2,"0")}`;if(!mm)return}
  const ym=mm.value;
  const sf=$("mStuFilter");const keep=sf.value;
  sf.innerHTML='<option value="">全部学生</option>'+db.students.map(x=>`<option value="${x.id}">${esc(x.name)}</option>`).join("");
  sf.value=keep||"";
  const onlyDone=$("mOnlyDone").checked;
  let inst=monthInstances(ym).filter(x=>x.subject!=="自习");   // 统计不含自习
  if(sf.value)inst=inst.filter(x=>x.stuId===sf.value);
  const use=onlyDone?inst.filter(x=>x.done):inst;
  const totalH=use.reduce((a,b)=>a+b.hours,0);
  const doneH=use.filter(x=>x.done).reduce((a,b)=>a+b.hours,0);
  const stuN=new Set(use.map(x=>x.stuId)).size;
  $("mStats").innerHTML=`
    <div class="stat"><div class="num">${use.length}</div><div class="label">上课节数（不含自习）</div></div>
    <div class="stat"><div class="num">${totalH.toFixed(1).replace(/\.0$/,"")}</div><div class="label">总课时（小时）</div></div>
    <div class="stat"><div class="num" style="color:#2f9e6e">${use.filter(x=>x.done).length}</div><div class="label">已上完（${doneH.toFixed(1).replace(/\.0$/,"")} 小时）</div></div>
    <div class="stat"><div class="num">${stuN}</div><div class="label">上课学生数</div></div>`;
  // 科目分布
  const bySubj={};
  inst.forEach(x=>{bySubj[x.subject]=bySubj[x.subject]||{n:0,h:0,doneN:0};bySubj[x.subject].n++;bySubj[x.subject].h+=x.hours;if(x.done)bySubj[x.subject].doneN++});
  const sk=Object.keys(bySubj).sort((a,b)=>bySubj[b].h-bySubj[a].h);
  $("mDetailTitle").textContent=`📚 科目分布 · ${ym}${sf.value?" · "+((stuById(sf.value)||{}).name||""):""}`;
  $("mBySubj").innerHTML=sk.length?`<div style="display:flex;flex-wrap:wrap;gap:10px">`+sk.map(k=>{const col=subjColor(k),v=bySubj[k];
    return `<div class="counter-card" style="border-color:${col.fg}33;min-width:130px"><span class="stu-dot" style="background:${col.fg}"></span><span class="subj" style="color:${col.fg}">${esc(k)}</span><b>${v.n}</b><span class="cnt">节 · ${v.h.toFixed(1).replace(/\.0$/,"")}h · 已上 ${v.doneN}</span></div>`}).join("")+`</div>`:`<div class="empty">暂无数据</div>`;
  // 每日明细
  const byDay={};
  inst.forEach(x=>{byDay[x.date]=byDay[x.date]||[];byDay[x.date].push(x)});
  const dk=Object.keys(byDay).sort();
  $("mDaily").innerHTML=dk.length?`<h3 style="margin-bottom:10px">📅 每日上课明细</h3><div style="max-height:320px;overflow:auto"><table style="min-width:560px"><thead><tr><th>日期</th><th>星期</th><th>节数</th><th>课时</th><th>课程</th></tr></thead><tbody>`+
    dk.map(d=>{const arr=byDay[d];const h=arr.reduce((a,b)=>a+b.hours,0);
      const wd=new Date(d+"T00:00:00").getDay();
      return `<tr><td>${d}</td><td>${DAYNAMES[wd]}</td><td>${arr.length}</td><td>${h.toFixed(1).replace(/\.0$/,"")}h</td>
        <td style="font-size:11px">${arr.map(x=>{const c=subjColor(x.subject);const nm=(stuById(x.stuId)||{}).name||"";
          return `<span class="tag" style="background:${c.bg};color:${c.fg};margin:1px 3px 1px 0">${x.course.start}-${x.course.end} ${esc(nm)}·${esc(x.subject)}</span>`}).join("")}</td></tr>`}).join("")+
    `</tbody></table></div>`:"";
}

