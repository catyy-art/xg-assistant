else window.addEventListener("load",()=>setTimeout(cloudInit,300));
/* save 时自动排队上云（防抖：连点也只发一次） */
const _origSave=function(){localStorage.setItem("xg_db",JSON.stringify(db));localStorage.setItem("xg_db_ts",String(Date.now()))};
/* 数据保存后排队上云（防抖 800ms；同步中则等 1.5s 后再补一次） */
window.__onDataSave=function(){
  if(!sbUser)return;
  setStatus("pend");
  clearTimeout(syncTimer);
  syncTimer=setTimeout(cloudPush,syncing?1500:800);
};
function dbg(m,o){if(window.__cloudDebug)console.log("[cloud]",m,o||"")}
function dataCount(o){return ["students","courses","grades","comms","memos"].reduce((s,k)=>s+((o&&Array.isArray(o[k]))?o[k].length:0),0)}
function applyCloud(cloud,silent){
  ["students","courses","grades","comms","memos"].forEach(k=>{if(Array.isArray(cloud[k]))db[k]=cloud[k]});
  _origSave();renderAll();setStatus("ok");
  if(!silent)toast("已从云端载入最新数据");
}
async function cloudPush(){
  if(!sbUser){dbg("push 跳过：未登录");return}
  if(syncing){dbg("push 跳过：正在同步");clearTimeout(syncTimer);syncTimer=setTimeout(cloudPush,1500);return}
  syncing=true;setStatus("sync");
  try{
    const {data:rows,error:e1}=await sb.from("app_data").select("id").eq("user_id",sbUser.id).limit(1);
    if(e1)throw e1;
    const payload={user_id:sbUser.id,data:db,updated_at:new Date().toISOString()};
    let err;
    if(rows&&rows.length)({error:err}=await sb.from("app_data").update(payload).eq("id",rows[0].id));
    else({error:err}=await sb.from("app_data").insert(payload));
    if(err)throw err;
    setStatus("ok");dbg("push 成功",dataCount(db)+" 条");
  }catch(e){console.warn("云同步失败",e);setStatus("err");$("cloudTxt").textContent="同步失败（点此重试）";dbg("push 失败",e.message||e)}
  syncing=false;
}
async function cloudPull(auto,silent){
  if(!sbUser)return;
  setStatus("sync");
  try{
    const {data:rows,error}=await sb.from("app_data").select("*").eq("user_id",sbUser.id).limit(1);
    if(error)throw error;
    if(rows&&rows.length&&rows[0].data&&dataCount(rows[0].data)>0){
      const cloud=rows[0].data,cn=dataCount(cloud),ln=dataCount(db);
      // 比较「最后修改时间」判断哪边更新
      const cloudT=new Date(rows[0].updated_at||0).getTime();
      const localT=+(localStorage.getItem("xg_db_ts")||0);
      dbg("拉取：云端"+cn+"条@"+new Date(cloudT).toLocaleString()+" / 本地"+ln+"条@"+new Date(localT).toLocaleString());
      if(ln===0){applyCloud(cloud,silent);return}
      if(JSON.stringify(cloud)===JSON.stringify(db)){setStatus("ok");return}
      if(lambdaNewer(cloudT,localT)){
        applyCloud(cloud,silent);
      }else{
        // 本地更新（或无法判断）：上传本地，避免覆盖新数据
        cloudPush();
        if(!silent)toast("本地数据较新，已上传到云端");
      }
    }else{
      // 云端为空：本地有数据则自动迁移
      if(dataCount(db)>0){cloudPush();if(!silent)toast("已把本地数据迁移到云端")}
      else setStatus("ok");
    }
  }catch(e){console.warn("云端拉取失败",e);setStatus("err");dbg("pull 失败",e.message||e)}
}
function lambdaNewer(cloudT,localT){return cloudT>localT+3000}   // 云端比本地新 3 秒以上才覆盖本地
/* 手动同步按钮：点状态条刷新 */
$("cloudStatus").onclick=e=>{if(e.target.id!=="cloudOut"&&sbUser)cloudPull(false)};
</script>
