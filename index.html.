/* 时间工具 */
function addMin(t,m){const [H,M]=t.split(":").map(Number);let tot=H*60+M+m;return String(Math.floor(tot/60)%24).padStart(2,"0")+":"+String(tot%60).padStart(2,"0")}
function durH(s,e){if(!s||!e)return 0;const [h1,m1]=s.split(":").map(Number),[h2,m2]=e.split(":").map(Number);return Math.max(0,(h2*60+m2-h1*60-m1)/60)}
function dur(s,e){const m=Math.round(durH(s,e)*60);return m>=60?`${Math.floor(m/60)}小时${m%60?m%60+"分":""}`:m+"分钟"}
